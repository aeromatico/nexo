# Nexo ERP - Environment Variables
# Copiar este archivo a .env y ajustar los valores

# Database Configuration
DB_ROOT_PASSWORD=nexo_admin_2024
DB_HOST=mariadb
DB_PORT=3306

# Frappe Configuration
FRAPPE_SITE_NAME=nexo.local
ADMIN_PASSWORD=Asd22842758
ENCRYPTION_KEY=

# Redis Configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# Bolivia Specific
COUNTRY_CODE=BO
TIMEZONE=America/La_Paz
CURRENCY=BOB
LOCALE=es_BO

# SIN (Sistema Impuestos Nacionales) - Bolivia
SIN_API_URL=https://pilotosiat.impuestos.gob.bo
SIN_NIT=
SIN_TOKEN=
SIN_MODALIDAD=1

# Multi-tenant Configuration
ENABLE_MULTITENANCY=true
DEFAULT_SITE=nexo.local
WILDCARD_DOMAIN=*.nexo.bo

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Development
DEBUG=1
DEVELOPER_MODE=1
